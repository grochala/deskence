#!@PYTHON@
# SPDX-License-Identifier: GPL-3.0-or-later
# Desktop icons helper. Started by the Deskence desktop icons GNOME Shell
# extension through Meta.WaylandClient; not meant to be started by hand.

import gettext
import locale
import sys

sys.path.insert(1, "@PKGDATADIR@")

try:
    locale.setlocale(locale.LC_ALL, "")
    locale.bindtextdomain("@GETTEXT_PACKAGE@", "@LOCALEDIR@")
    locale.textdomain("@GETTEXT_PACKAGE@")
except (locale.Error, AttributeError):
    pass
gettext.bindtextdomain("@GETTEXT_PACKAGE@", "@LOCALEDIR@")
gettext.textdomain("@GETTEXT_PACKAGE@")

import gi  # noqa: E402

gi.require_version("Gdk", "4.0")
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")

from deskence_desktop.app import DesktopApplication  # noqa: E402

sys.exit(DesktopApplication().run([sys.argv[0]]))
