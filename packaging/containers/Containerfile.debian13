FROM docker.io/library/debian:trixie
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential debhelper devscripts dh-python meson ninja-build gettext libglib2.0-dev-bin libglib2.0-bin \
    desktop-file-utils appstream python3 python3-gi gir1.2-adw-1 gir1.2-gtk-4.0 gjs \
    gnome-shell gnome-shell-common mutter-common dbus dbus-x11 gir1.2-mutter-16 nautilus gvfs xdg-user-dirs \
    locales fonts-cantarell adwaita-icon-theme mesa-utils libgl1-mesa-dri python3-pytest && \
    sed -i 's/# pl_PL.UTF-8/pl_PL.UTF-8/' /etc/locale.gen && locale-gen && apt-get clean
