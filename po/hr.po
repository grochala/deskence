#: src/deskence/pages.py:725
msgid ""
"Size, placement, click behavior and shown items return to their defaults. "
"Your files and the positions of icons do not change."
msgstr ""
"Veličina, postavljanje, ponašanje pri kliku i prikazane stavke vraćaju se na "
"zadane vrijednosti. Vaše datoteke i položaji ikona ne mijenjaju se."

