msgstr "Výber ikony"

#: src/deskence/pages.py:612 src/deskence/general.py:357
#: src/deskence/general.py:382
msgid "Only local files can be used."
msgstr "Použiť možno len miestne súbory."

#: src/deskence/pages.py:617
msgid ""
"The file is not an image in a supported format (PNG, SVG, JPEG or WebP) of "
"at most 4 MB."
msgstr ""
"Súbor nie je obrázok v podporovanom formáte (PNG, SVG, JPEG alebo WebP) s "
"veľkosťou najviac 4 MB."

#: src/deskence/pages.py:629
msgid "Cannot Use This Image"
msgstr "Tento obrázok sa nedá použiť"

#: src/deskence/pages.py:651
#, python-brace-format
msgid "{} (disconnected)"
msgstr "{} (odpojené)"

#: src/deskence/pages.py:720
msgid "No desktop folder is set up"
msgstr "Nie je nastavený žiadny priečinok pracovnej plochy"

#: src/deskence/pages.py:724
msgid "Restore Default Desktop Icon Settings?"
msgstr "Obnoviť predvolené nastavenia ikon pracovnej plochy?"

#: src/deskence/pages.py:725
msgid ""
"Size, placement, click behavior and shown items return to their defaults. "
"Your files and the positions of icons do not change."
msgstr ""
"Veľkosť, umiestnenie, správanie pri kliknutí a zobrazené položky sa vrátia "
"na predvolené hodnoty. Vaše súbory a umiestnenia ikon sa nezmenia."

#: src/deskence/pages.py:740
msgid "Icons stay exactly where you drop them"
