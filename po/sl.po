msgstr "Pripeti predmeti se shranjujejo v {}"

#: src/deskence/pages.py:933
#, python-brace-format
msgid "The history is saved in {}"
msgstr "Zgodovina se shranjuje v {}"

#: src/deskence/pages.py:967
msgid "Restore Default Top Bar Settings?"
msgstr "Ali želite obnoviti privzete nastavitve zgornje vrstice?"

