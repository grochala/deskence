msgid "_Cancel"
msgstr "_Cealaigh"

#: src/deskence/pages.py:200
msgid "Not installed. Reinstall the deskence package."
msgstr "Níl sé suiteáilte. Athshuiteáil an pacáiste deskence."

#: src/deskence/pages.py:204
msgid "Starts after you log out and log in again"
msgstr "Tosaíonn sé tar éis duit logáil amach agus logáil isteach arís"

#: src/deskence/pages.py:205
msgid "Updated; the new version starts after you log in again"
msgstr "Nuashonraithe; tosaíonn an leagan nua tar éis duit logáil isteach arís"

#: src/deskence/pages.py:206
msgid "GNOME Shell is not running; applies in the next GNOME session"
msgstr ""
"Níl GNOME Shell ag rith; cuirfear i bhfeidhm é sa chéad seisiún GNOME eile"

#: src/deskence/pages.py:207
msgid "Not running"
msgstr "Níl sé ag rith"

#: src/deskence/pages.py:230
msgid "The feature stopped because of an error"
msgstr "Stop an ghné de bharr earráide"

#: src/deskence/pages.py:232
msgid "This GNOME version is not supported"
msgstr "Ní thacaítear leis an leagan seo de GNOME"

#: src/deskence/pages.py:233
#, python-brace-format
msgid "The installed version does not support GNOME {}."
msgstr "Ní thacaíonn an leagan suiteáilte le GNOME {}."

#: src/deskence/pages.py:236 src/deskence/cli.py:179
msgid "GNOME extensions are turned off"
msgstr "Tá eisínteachtaí GNOME múchta"

#: src/deskence/pages.py:237
msgid "Deskence needs them to show its features."
msgstr "Tá siad ag teastáil ó Deskence chun a ghnéithe a thaispeáint."

#: src/deskence/pages.py:238
msgid "_Turn On…"
msgstr "_Cas Air…"

#: src/deskence/pages.py:240
msgid "Another copy is used instead"
msgstr "Tá cóip eile á húsáid ina háit"

#: src/deskence/pages.py:241
#, python-brace-format
msgid "A copy in your home folder replaces the installed one: {}"
msgstr "Cuireann cóip i d'fhillteán baile in ionad na cóipe suiteáilte: {}"

#: src/deskence/pages.py:243
msgid "_Show"
msgstr "_Taispeáin"

#: src/deskence/pages.py:247
msgid "Turn On GNOME Extensions?"
msgstr "An gcasfar eisínteachtaí GNOME air?"

#: src/deskence/pages.py:248
msgid ""
"This also turns on other extensions you enabled in the Extensions "
"application."
msgstr ""
"Casann sé seo air eisínteachtaí eile a chumasaigh tú san fheidhmchlár "
"Eisínteachtaí freisin."

#: src/deskence/pages.py:249
msgid "_Turn On"
msgstr "_Cas Air"

