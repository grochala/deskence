#: src/deskence/pages.py:258
msgid "desktop icons"
msgstr "deilbhíní deisce"

#: src/deskence/pages.py:259
msgid "application icons in the top bar"
msgstr "deilbhíní feidhmchlár sa bharra barr"

#: src/deskence/pages.py:260
msgid "sorting of the applications view"
msgstr "sórtáil amharc na bhfeidhmchlár"

#: src/deskence/pages.py:261
msgid "a clipboard history"
msgstr "stair gearrthaisce"

#: src/deskence/pages.py:262
msgid "keeping the computer awake"
msgstr "coinneáil an ríomhaire múscailte"

#: src/deskence/pages.py:265
#, python-brace-format
msgid "Also provides {}. Using both at once causes problems."
msgstr ""
"Soláthraíonn sé {} freisin. Bíonn fadhbanna ann má úsáidtear an dá cheann le "
"chéile."

#: src/deskence/pages.py:267
#, python-brace-format
msgid "May also provide {}."
msgstr "D'fhéadfadh sé {} a sholáthar freisin."

#: src/deskence/pages.py:271
#, python-brace-format
msgid "Disable “{}”?"
msgstr "An ndíchumasófar “{}”?"

#: src/deskence/pages.py:272
msgid ""
"The extension stays installed and its settings are kept. You can turn it on "
"again in the Extensions application."
msgstr ""
"Fanann an eisínteacht suiteáilte agus coinnítear a socruithe. Is féidir leat "
"í a chasadh air arís san fheidhmchlár Eisínteachtaí."

#: src/deskence/pages.py:274 src/deskence/shortcuts.py:90
msgid "_Disable"
msgstr "_Díchumasaigh"

#: src/deskence/pages.py:275
msgid "_Disable…"
msgstr "_Díchumasaigh…"

#: src/deskence/pages.py:355
msgid "Subtle"
msgstr "Lag"

#: src/deskence/pages.py:356
msgid "Strong"
msgstr "Láidir"

#: src/deskence/pages.py:358
msgid "Magnification Strength"
msgstr "Neart an mhéadaithe"

#: src/deskence/pages.py:372 src/deskence/pages.py:806
#: src/deskence/ui/dock-page.ui:117
msgid "Background Transparency"
msgstr "Trédhearcacht an chúlra"

#: src/deskence/pages.py:386
msgid "Icon Size"
msgstr "Méid na ndeilbhíní"

#: src/deskence/pages.py:396
msgid "The dock is always visible and windows do not cover it"
msgstr "Bíonn an duga le feiceáil i gcónaí agus ní chlúdaíonn fuinneoga é"

#: src/deskence/pages.py:397
msgid "Hides while a window overlaps it"
msgstr "Ceilt fad is a fhorluíonn fuinneog é"

#: src/deskence/pages.py:398
msgid "Appears when you move the pointer to the screen edge"
msgstr ""
"Tagann sé chun solais nuair a bhogann tú an pointeoir go himeall an scáileáin"

#: src/deskence/pages.py:401
msgid "A second click switches to the next window of the application"
msgstr ""
"Athraíonn an dara cliceáil go dtí an chéad fhuinneog eile den fheidhmchlár"

#: src/deskence/pages.py:402
msgid "Clicking an application with one focused window minimizes it"
msgstr "Íoslaghdaíonn cliceáil ar fheidhmchlár le fuinneog amháin le fócas í"

#: src/deskence/pages.py:415
msgid "Restore Default Dock Settings?"
msgstr "An athchóireofar socruithe réamhshocraithe an duga?"

#: src/deskence/pages.py:416
msgid ""
"Position, size, colors, hiding, monitor, click behavior and shown items "
"return to their defaults. Pinned applications, folders in the dock, the "
"applications view and whether the dock is shown do not change."
msgstr ""
"Filleann suíomh, méid, dathanna, ceilt, scáileán, iompar cliceála agus na "
"míreanna a thaispeántar ar a réamhshocruithe. Ní athraíonn feidhmchláir "
"phionnáilte, fillteáin sa duga, amharc na bhfeidhmchlár ná cé acu an "
"dtaispeántar an duga."

#: src/deskence/pages.py:419 src/deskence/pages.py:727
#: src/deskence/pages.py:838 src/deskence/pages.py:925
#: src/deskence/pages.py:970 src/deskence/pages.py:1007
#: src/deskence/pages.py:1048 src/deskence/general.py:100
msgid "_Restore"
msgstr "_Athchóirigh"

#: src/deskence/pages.py:430
msgid "Not shown while animations are turned off in Accessibility settings"
msgstr ""
"Ní thaispeántar é nuair atá beochan múchta i socruithe na hinrochtaineachta"

#: src/deskence/pages.py:450 src/deskence/ui/dock-page.ui:348
msgid "Add Folder"
msgstr "Cuir Fillteán Leis"

#: src/deskence/pages.py:464
msgid "Other Folder…"
msgstr "Fillteán Eile…"

#: src/deskence/pages.py:476
msgid "Not set up on this computer"
msgstr "Níl sé socraithe ar an ríomhaire seo"

#: src/deskence/pages.py:480
#, python-brace-format
msgid "{} (missing)"
msgstr "{} (ar iarraidh)"

#: src/deskence/pages.py:498
msgid "Move Up"
msgstr "Bog Suas"

#: src/deskence/pages.py:499
msgid "Move Down"
msgstr "Bog Síos"

#: src/deskence/pages.py:506 extensions/dock/stacks.js:376
msgid "Remove From Dock"
msgstr "Bain den Duga"

#: src/deskence/pages.py:540
msgid "Add Folder to the Dock"
msgstr "Cuir Fillteán leis an Duga"

#: src/deskence/pages.py:549
msgid "Cannot Add This Folder"
msgstr "Ní Féidir an Fillteán Seo a Chur Leis"

