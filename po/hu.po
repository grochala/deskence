msgid "Only local files can be used."
msgstr "Csak helyi fájlok használhatók."

#: src/deskence/pages.py:617
msgid ""
"The file is not an image in a supported format (PNG, SVG, JPEG or WebP) of "
"at most 4 MB."
msgstr ""
"A fájl nem támogatott formátumú (PNG, SVG, JPEG vagy WebP), legfeljebb 4 MB-"
