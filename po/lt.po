#: src/deskence/pages.py:581
msgid "No logo is installed; the default icon is used"
msgstr "Logotipas neįdiegtas; naudojama numatytoji piktograma"

#: src/deskence/pages.py:593
msgid "No image chosen; the default icon is used"
msgstr "Paveikslėlis nepasirinktas; naudojama numatytoji piktograma"

#: src/deskence/pages.py:594
msgid "The image is missing; the default icon is used"
msgstr "Paveikslėlio trūksta; naudojama numatytoji piktograma"

#: src/deskence/pages.py:597
msgid "Images"
msgstr "Paveikslėliai"

#: src/deskence/pages.py:602
msgid "Choose an Icon"
msgstr "Pasirinkite piktogramą"

#: src/deskence/pages.py:612 src/deskence/general.py:357
#: src/deskence/general.py:382
msgid "Only local files can be used."
msgstr "Galima naudoti tik vietinius failus."

#: src/deskence/pages.py:617
msgid ""
"The file is not an image in a supported format (PNG, SVG, JPEG or WebP) of "
"at most 4 MB."
msgstr ""
"Failas nėra palaikomo formato (PNG, SVG, JPEG arba WebP) ne didesnis kaip 4 "
"MB paveikslėlis."

#: src/deskence/pages.py:629
msgid "Cannot Use This Image"
msgstr "Šio paveikslėlio naudoti negalima"

#: src/deskence/pages.py:651
#, python-brace-format
